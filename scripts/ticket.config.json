{
  "prefix": "MCPA",
  "tracker": "local",
  "timeZone": "Europe/Berlin",
  "plansDir": "docs/plans",
  "protectedBranches": [
    "main"
  ],
  "captureSources": [
    "Claude",
    "Codex",
    "Gemini",
    "ChatGPT",
    "Notion AI",
    "Other"
  ],
  "verify": {
    "fast": "npm run typecheck",
    "test": "npm test",
    "full": "npm run typecheck && npm run build && npm test"
  },
  "verifyCommand": "npm test",
  "hygiene": {
    "maxFileSizeKB": 1024,
    "disallowedPatterns": [
      ".tmp",
      "test-results",
      "coverage",
      ".worktrees"
    ]
  },
  "agentic": {
    "maxRetries": 3,
    "verifyTier": "test",
    "models": {
      "planner": "gemini-4-neon-medium",
      "builder": "gemini-4-hydrogen-medium",
      "fixer": "gemini-4-hydrogen-medium",
      "reviewer": "gemini-4-neon-low"
    }
  },
  "requireReview": true,
  "allowSelfReview": false,
  "invariants": {
    "mirrorDirs": [],
    "noSecretsPatterns": [
      "\\bntn_[A-Za-z0-9]{10,}",
      "\\bsecret_[A-Za-z0-9]{10,}",
      "\\bghp_[A-Za-z0-9]{20,}",
      "\\bgithub_pat_[A-Za-z0-9_]{20,}"
    ],
    "excludePaths": [
      "scripts/ticket.test.mjs",
      "scripts/ticket.config.json",
      "fixtures/malicious-mcp/claude_desktop_config.json",
      "test/fixtures.test.ts",
      "test/rules.test.ts"
    ]
  },
  "appetite": {
    "S": {
      "maxLines": 150,
      "maxFiles": 5
    },
    "M": {
      "maxLines": 450,
      "maxFiles": 12
    },
    "L": {
      "maxLines": 1000,
      "maxFiles": 25
    }
  },
  "versioning": {
    "enabled": false,
    "currentVersion": "1.0.0",
    "activeTrain": "1.1.0",
    "roadmapPath": "docs/ROADMAP.md",
    "changelogPath": "CHANGELOG.md",
    "tagPrefix": "v",
    "requireVersionOnPlans": false
  },
  "noPlan": {
    "maxChangedLines": 40,
    "noNewFilesUnder": [
      "src"
    ]
  },
  "mode": "universal"
}
